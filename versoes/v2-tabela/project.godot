; Engine configuration file.
config_version=5

[application]

config/name="DimEsgoto"
config/description="Dimensionamento de redes coletoras de esgoto sanitário"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
run/low_processor_mode=false

[display]

window/size/viewport_width=1366
window/size/viewport_height=820
window/stretch/mode="disabled"
window/subwindows/embed_subwindows=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
